APP_ENV=dev
AUTH_MODE=development_headers
ALLOW_DEV_AUTH=true
PERSISTENCE_BACKEND=postgres
DATABASE_URL=postgresql+psycopg://market_agent:market_agent@localhost:5433/market_agent
REDIS_URL=redis://localhost:6380/0
OIDC_ISSUER=http://localhost:8080/realms/market-assistant
OIDC_AUDIENCE=market-assistant-api
OIDC_JWKS_URL=http://localhost:8080/realms/market-assistant/protocol/openid-connect/certs
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_PROVIDER=openai_compatible
LLM_PROMPT_VERSION=market-agent-v1
AGENT_MAX_STEPS=12
AGENT_MAX_LLM_CALLS=2
AGENT_MAX_TOOL_CALLS=3
AGENT_TOTAL_TIMEOUT_SECONDS=15
LLM_CONNECT_TIMEOUT_SECONDS=3
LLM_TIMEOUT_SECONDS=8
LLM_MAX_OUTPUT_TOKENS=800
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0
EMBEDDING_PROVIDER=hash
EMBEDDING_BASE_URL=http://localhost:7997
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
BUSINESS_CONNECTOR_MODE=repository
BUSINESS_CONNECTOR_BASE_URL=
BUSINESS_CONNECTOR_API_KEY=
BUSINESS_CONNECTOR_TIMEOUT_SECONDS=5
WORKER_METRICS_PORT=9100
METRICS_TENANT_ID=tenant_demo
RETRIEVAL_PROFILE_ID=hash-v1
INLINE_WORKER=false
WORKER_ID=worker-local
TASK_LEASE_SECONDS=30
TASK_MAX_ATTEMPTS=3
ANSWERABILITY_THRESHOLD=0.015
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional host ports. M3 drill uses an isolated override file.
POSTGRES_PORT=5433
REDIS_PORT=6380
KEYCLOAK_PORT=8080
API_PORT=8000
WEB_PORT=5173
PROMETHEUS_PORT=9090
EMBEDDING_PORT=7997
SIMULATOR_PORT=8090
SIMULATOR_CONTROL_TOKEN=m3-drill-control
